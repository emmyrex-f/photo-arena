# Production env template for VPS Docker Compose.
# Copy to /var/www/photo-arena/.env on the server and fill real values.
# Never commit a filled .env.

# --- Postgres (compose interpolates these; not exposed on the host) ---
POSTGRES_USER=photoarena
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=photoarena

# Overridden by compose for the api service to point at the `db` container.
# Keep a matching URL here for tools that read .env directly.
DATABASE_URL=postgresql://photoarena:change-me-strong-db-password@db:5432/photoarena

NODE_ENV=production
PORT=3001
TZ=Africa/Lagos

# Strong secret, >= 32 characters (generate on the server; do not reuse elsewhere)
JWT_SECRET=change-me-to-a-long-random-secret

# Behind nginx / Docker web proxy
TRUST_PROXY=true

# Comma-separated https origins (no trailing slash)
PUBLIC_SITE_ORIGINS=https://photoarenang.com,https://www.photoarenang.com

# Public API base used in admin / webhook display (no trailing slash)
PUBLIC_API_URL=https://photoarenang.com

# Local disk uploads (Compose mounts named volume at /app/uploads)
STORAGE_PROVIDER=local
UPLOADS_DIR=/app/uploads

# Payments — REQUIRED in production (app refuses to boot without a key)
# Live key from Bachs; never commit. Leave empty until you have the real key.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=change-me-bachs-webhook-secret
BACHS_BASE_URL=https://api.bachs.io
PAYMENTS_MOCK=false

# Email — REQUIRED in production (RESEND preferred, or SMTP_*)
RESEND_API_KEY=
RESEND_FROM=Photo Arena <noreply@photoarenang.com>
NOTIFICATION_EMAIL_RECIPIENTS=owner@photoarenang.com

# Optional SMTP fallback (if RESEND_API_KEY unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Seed owner (on first migrate/seed only — change immediately after bootstrap)
SEED_OWNER_EMAIL=owner@photoarenang.com
SEED_OWNER_PASSWORD=change-me-strong-owner-password
SEED_OWNER_NAME=Photo Arena Owner
