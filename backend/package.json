{
  "name": "photo-arena-backend",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "version": "0.1.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:constraints": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/studio-resource-single-active.sql && prisma db execute --schema prisma/schema.prisma --file prisma/sql/booking-overlap-exclude.sql",
    "verify:rules": "tsx scripts/verify-rules.ts",
    "verify:calendar": "tsx scripts/verify-calendar.ts",
    "verify:bachs-webhook": "tsx scripts/verify-bachs-webhook.ts",
    "verify:payment-flow": "tsx scripts/verify-payment-flow.ts",
    "verify:security": "tsx scripts/verify-security.ts",
    "verify:storage": "tsx scripts/verify-storage.ts",
    "verify:notifications": "tsx scripts/verify-notifications.ts",
    "verify:admin-booking": "tsx scripts/verify-admin-booking.ts",
    "verify:auth": "tsx scripts/verify-auth-features.ts",
    "test:system": "tsx scripts/run-complete-system-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^12.0.1",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.29.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
