DATABASE_URL="postgresql://photoarena:photoarena@localhost:5432/photoarena"
# Local desk cluster (created by initdb, trust auth): postgresql://photoarena@localhost:55432/photoarena
PORT=3001
TZ=Africa/Lagos

# Detect environment from prefix only: sk_sandbox_ or sk_live_
# Empty API key is not mock mode. Set PAYMENTS_MOCK=true for local mock checkout.
BACHS_API_KEY=
# From Bachs Developer Portal → Webhooks → destination signing secret (sandbox ≠ live)
# Local: any non-empty secret enables signed webhook tests with Mock checkout.
BACHS_WEBHOOK_SECRET="whsec_local_photo_arena_dev"
BACHS_BASE_URL="https://sandbox-api.bachs.io"
# Used to display the webhook URL in admin (no trailing slash)
PUBLIC_API_URL="http://localhost:3001"
# Public webhook URL to register in Bachs (sandbox destination first):
# {PUBLIC_API_URL}/api/payments/webhook/bachs
# Subscribe: collection.succeeded, collection.failed, collection.abandoned, refund.paid

# Two recipients, same content
NOTIFICATION_EMAIL_RECIPIENTS="owner@example.com,manager@example.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Photo Arena <noreply@photoarenang.com>"

JWT_SECRET=change-me

# Explicit mock checkout (local/dev only). Ignored/forbidden when NODE_ENV=production.
PAYMENTS_MOCK=true
# Honor X-Forwarded-For / req.ip when behind Nginx or Cloudflare.
TRUST_PROXY=false
# Comma-separated public site origins (no trailing slash).
# Used for: Bachs return/cancel URL allowlist AND browser CORS allowlist.
# Production: required, https only (e.g. https://photoarenang.com,https://www.photoarenang.com).
# Non-production: localhost:5173 / 127.0.0.1:5173 are always included in addition to this list.
PUBLIC_SITE_ORIGINS="http://localhost:5173"

SEED_OWNER_EMAIL="owner@photoarenang.com"
SEED_OWNER_PASSWORD="changeme"
SEED_OWNER_NAME="Photo Arena Owner"
